# Copy this file to .env.local and fill in the values from your Supabase
# project's Settings -> API page. .env.local is gitignored — never commit
# real values.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudflare Turnstile site key (public/client-safe) — from the Cloudflare
# dashboard, same widget whose secret key is configured in the Supabase
# project's Authentication > Attack Protection settings (never put the
# secret key here or anywhere in this repo).
VITE_TURNSTILE_SITE_KEY=
